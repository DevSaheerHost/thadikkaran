{
  "rules": {
    ".read": false,
    ".write": false,

    "admin": {
      "allowedUids": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "fcmTokens": {
        ".read": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "services": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "bookings": {
      ".read": "auth != null",
      "$date": {
        ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
        "$bookingId": {
          ".write": "auth != null && (root.child('admin/allowedUids').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && newData.exists()))",
          ".validate": "root.child('admin/allowedUids').child(auth.uid).val() === true || (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid)",
          "name":        { ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 60" },
          "serviceName": { ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 60" },
          "cancelReason":{ ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 200" },
          "bookingFor":  { ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 60" },
          "$other":      { ".validate": "!newData.isString() || newData.val().length <= 200" }
        }
      }
    },

    "slots": {
      ".read": "auth != null",
      "$date": {
        "$time": {
          ".validate": "newData.isString() && newData.val().length <= 60",
          ".write": "auth != null && (root.child('admin/allowedUids').child(auth.uid).val() === true || !data.exists() || !root.child('bookings').child($date).child(data.val()).exists() || root.child('bookings').child($date).child(data.val()).child('status').val() === 'cancelled' || root.child('bookings').child($date).child(data.val()).child('status').val() === 'noshow' || root.child('bookings').child($date).child(data.val()).child('startTime').val() !== $time)"
        }
      }
    },

    "blocked": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "deleted": {
      ".read": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "noshows": {
      ".read": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "notes": {
      ".read":  "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "blockedPhones": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && (root.child('admin/allowedUids').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['uid','rating'])",
        "text":         { ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 500" },
        "customerName": { ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 60" },
        "rating":       { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "$other":       { ".validate": "!newData.isString() || newData.val().length <= 200" }
      }
    },

    "reminders": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)"
      }
    },

    "contacts": {
      ".read": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
      "$date": {
        "$bookingId": {
          ".write": "auth != null && !data.exists()",
          "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "name":  { ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": "!newData.isString() || newData.val().length <= 100" }
        }
      }
    },

    "waitlist": {
      "$date": {
        ".read": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
        "phone":     { ".write": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)",
                       ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 20" },
        "fcmToken":  { ".write": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)",
                       ".validate": "!newData.exists() || newData.isString() && newData.val().length <= 400" },
        "bookings":  { ".write": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)" }
      }
    }
  }
}
